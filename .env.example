# Where the masked text is sent — used by the caddy /llm/* proxy.
# The key stays server-side: caddy attaches it at egress, it never
# touches the browser. Copy this file to .env (gitignored), set your
# key, restart: docker compose up
#
# No .env at all? The demo still works up to the masked-text tab —
# the LLM step just reports "not configured".
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=sk-...
# Model used by examples/llm-roundtrip.sh (the demo has a model field in the UI instead).
LLM_MODEL=gpt-4o-mini

# Alternatives — any OpenAI-compatible chat-completions endpoint works:
#   Anthropic:            LLM_BASE_URL=https://api.anthropic.com          LLM_MODEL=claude-sonnet-4-6
#   Ollama (fully local): LLM_BASE_URL=http://host.docker.internal:11434  LLM_MODEL=llama3.1
